# ===========================
# PostgreSQL Database
# ===========================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=your_database_name
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password

# ===========================
# Kafka Settings
# ===========================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=ecommerce-transactions

# ===========================
# Spark Settings
# ===========================
SPARK_APP_NAME=RealTimeEcommerceDataPlatform
SPARK_MASTER=local[*]

# ===========================
# Airflow Settings
# ===========================
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=your_password
AIRFLOW_ADMIN_EMAIL=your@email.com

# ===========================
# Metabase Settings
# ===========================
METABASE_PORT=3001

# ===========================
# Pipeline Settings
# ===========================
TRANSACTION_RATE=0.5
