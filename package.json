{
  "name": "real-time-ecommerce-data-platform",
  "private": true,
  "version": "2.0.0",
  "description": "Real-Time E-commerce Data Platform with a live local analytics dashboard",
  "scripts": {
    "start": "node dashboard/server.mjs",
    "dev": "node --watch dashboard/server.mjs",
    "test": "node --test dashboard/test/*.test.mjs",
    "check": "node dashboard/scripts/check.mjs",
    "db:migrate": "node dashboard/scripts/migrate.mjs",
    "worker": "node dashboard/worker.mjs",
    "auth:hash": "node dashboard/scripts/hash-password.mjs",
    "secrets:setup": "node dashboard/scripts/setup-secrets.mjs",
    "ingest": "node dashboard/scripts/ingest.mjs"
  },
  "engines": {
    "node": ">=24 <27"
  },
  "dependencies": {
    "kafkajs": "2.2.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "yaml": "2.9.1"
  }
}
