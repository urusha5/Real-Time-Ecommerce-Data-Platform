# Copy to .env.production. Secret values belong in secrets/, not this file.
DOMAIN=commerce.example.com
ADMIN_USERNAME=operator
# Optional externally managed Kafka (enable with --profile kafka):
KAFKA_BROKERS=
KAFKA_TOPIC=ecommerce-transactions
KAFKA_GROUP_ID=commerce-platform-v1
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
